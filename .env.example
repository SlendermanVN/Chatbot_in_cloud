# ============================================================
# ENVIRONMENT VARIABLES - Azure Web App Service Configuration
# Copy to .env and update with your actual values
# ============================================================

# ============================================================
# AZURE CONTAINER REGISTRY (for image deployment)
# ============================================================
REGISTRY_URL=chatbotcloudcomputing.azurecr.io
REGISTRY_USERNAME=your-registry-username
REGISTRY_PASSWORD=your-registry-password
IMAGE_NAME=sportzone-web
IMAGE_TAG=latest

# ============================================================
# AZURE MYSQL DATABASE
# ============================================================
# Connection: Replace with your Azure MySQL server details
AZURE_MYSQL_HOST=your-server-name.mysql.database.azure.com
AZURE_MYSQL_USER=admin_username
AZURE_MYSQL_PASSWORD=SecurePassword123!
AZURE_MYSQL_DATABASE=sportzone
AZURE_MYSQL_PORT=3306
MYSQL_SSL_MODE=REQUIRED
MYSQL_SSL_CA=/app/baltimore-cybertrust-root.crt.pem

# ============================================================
# AZURE CACHE FOR REDIS (with SSL)
# ============================================================
# Note: Azure Redis uses SSL (port 6380 by default, not 6379)
AZURE_REDIS_HOST=your-redis-name.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=your-redis-primary-key
REDIS_SSL=true

# ============================================================
# AZURE APPLICATION INSIGHTS (Monitoring)
# ============================================================
# Get this from Azure Portal > Application Insights > Connection String
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://region.in.applicationinsights.azure.com/;LiveEndpoint=https://region.livediagnostics.monitor.azure.com/;ApplicationId=your-app-id
APPINSIGHTS_INSTRUMENTATION_KEY=your-instrumentation-key

# ============================================================
# OLLAMA AI ENGINE (Optional - can be external)
# ============================================================
# Local development: http://ai-engine:11434
# Production/Azure: Comment out or use external AI service
AI_ENDPOINT=http://ai-engine:11434
OLLAMA_HOST=http://ai-engine:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_NUM_PARALLEL=2
OLLAMA_NUM_THREAD=4

# ============================================================
# PHP APPLICATION CONFIGURATION
# ============================================================
PHP_MEMORY_LIMIT=256M
MAX_UPLOAD_SIZE=20M
TZ=Asia/Ho_Chi_Minh

# Application URLs and Settings
BASE_URL=/
APP_ENV=production
APP_DEBUG=false

# ============================================================
# LOCAL DEVELOPMENT (for docker-compose.yaml)
# ============================================================
# Uncomment and set for local development
# AZURE_MYSQL_HOST=localhost
# AZURE_MYSQL_USER=root
# AZURE_MYSQL_PASSWORD=root
# AZURE_REDIS_HOST=localhost
# AZURE_REDIS_PASSWORD=
# APPINSIGHTS_CONNECTION_STRING=
