# ============================================================
# AZURE CONTAINER REGISTRY (for image deployment)
# ============================================================
REGISTRY_URL=chatbotcloudcomputing.azurecr.io
REGISTRY_USERNAME=chatbotcloudcomputing
REGISTRY_PASSWORD=76hHtRlGlny070VSev7uqNl4CB6FyDoLAgDcyPfm74pwNw2zu2HhJQQJ99CEAC3pKaREqg7NAAACAZCRKqZf
IMAGE_NAME=sportzone-web
IMAGE_TAG=latest

# ============================================================
# AZURE MYSQL DATABASE
# ============================================================
# Connection: Replace with your Azure MySQL server details
AZURE_MYSQL_HOST=cybervn-database-server.mysql.database.azure.com
AZURE_MYSQL_USER=SlendermanVN
AZURE_MYSQL_PASSWORD=CyberVN2004*
AZURE_MYSQL_PORT=3306
MYSQL_SSL_MODE=REQUIRED
MYSQL_SSL_CA=/app/baltimore-cybertrust-root.crt.pem

# ============================================================
# AZURE CACHE FOR REDIS (with SSL)
# ============================================================
# Note: Azure Redis uses SSL (port 6380 by default, not 6379)
AZURE_REDIS_HOST=sportzone-chatbot.eastasia.redis.azure.net:10000
AZURE_REDIS_PORT=10000
AZURE_REDIS_PASSWORD=D_xjGtoxcAofb10lJLgEOav-m0Lxg9nWGAZCAFuCnmw=
REDIS_SSL=true

# ============================================================
# AZURE APPLICATION INSIGHTS (Monitoring)
# ============================================================
# Get this from Azure Portal > Application Insights > Connection String
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=178c2cff-168b-4fee-b10d-d080fa57523b;IngestionEndpoint=https://eastasia-0.in.applicationinsights.azure.com/;LiveEndpoint=https://eastasia.livediagnostics.monitor.azure.com/;ApplicationId=9a2a6904-67a3-4b66-9238-bac7479e91ea
APPINSIGHTS_INSTRUMENTATION_KEY=178c2cff-168b-4fee-b10d-d080fa57523b

# ============================================================
# PHP APPLICATION CONFIGURATION
# ============================================================
PHP_MEMORY_LIMIT=256M
MAX_UPLOAD_SIZE=20M
TZ=Asia/Ho_Chi_Minh

# Application URLs and Settings
BASE_URL=/
APP_ENV=production
APP_DEBUG=false

