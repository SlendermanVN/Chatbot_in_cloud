# ===========================================
# SportZone Vietnam - Git Ignore
# ===========================================


# Config chứa thông tin nhạy cảm (mỗi dev tự tạo)
config/database.local.php
.env
.env.local

# IDE / Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
error_log
/logs/

# Backup & tạm
*.bak
*.tmp
*.swp
*~

# Composer (nếu sau này dùng)
/vendor/
composer.lock

# Node (nếu dùng build tool)
/node_modules/
npm-debug.log
yarn-error.log

# Sensitive
secrets.json
*.pem
*.key
